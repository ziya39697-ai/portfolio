# SMTP (for make run-email: send proposal to addresses in job description)
# Leave SMTP_HOST/FROM_EMAIL empty to skip sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=test@gmail.com
SMTP_PASSWORD=random_password
FROM_EMAIL=from_email@gmail.com

# Optional: where contact-form messages are delivered. Defaults to FROM_EMAIL.
CONTACT_TO_EMAIL=

# MongoDB — used to persist contact-form rate limits across serverless cold starts.
# If MONGO_URL is empty, rate limits fall back to in-memory (per-instance only).
MONGO_URL=
MONGO_DB=portfolio
